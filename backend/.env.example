# Copy to .env and fill in real values. NEVER commit .env.

# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# PostgreSQL connection (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://admin:admin@localhost:5432/admin_manager

# JWT lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173
